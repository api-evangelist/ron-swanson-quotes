        {
          "id": "63f249a9-9752-4f32-ac22-287c506bce2e",
          "name": "Ron Swanson Quotes Search Quotes",
          "request": {
            "name": "Ron Swanson Quotes Search Quotes",
            "description": {
              "content": "Return every Ron Swanson quote whose text contains the URL-escaped `term` substring. Matching is case-insensitive. The response is an array of zero or more quote strings; an empty array is returned when no quotes match.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "quotes",
                "search",
                ":term"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "term",
                  "description": "(Required) URL-encoded search term. Matched against the quote corpus without case sensitivity. Whole-word matching is not enforced - substrings also match."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "4060ee23-06d2-4861-a681-20d775b2f63e",
              "name": "An array of zero or more quotes that contain `term`.",
